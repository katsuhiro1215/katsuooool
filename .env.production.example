# 本番用の環境変数の雛形。サーバー上で .env.production にコピーして値を入れる（コミットしない）。
APP_NAME=katsuooool
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://katsuooool.smartsprouts.jp

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite（WAL）。storage ボリューム内に置く
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/database.sqlite
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_BUSY_TIMEOUT=5000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log

PREMIUM_ENABLED=false

STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CASHIER_CURRENCY=jpy
CASHIER_CURRENCY_LOCALE=ja_JP

# 本体のお問い合わせ API。キーは本番値をサーバー上でのみ設定する
SPRA_CONTACT_API_BASE=https://smartsprouts.jp/api/contacts
SPRA_CONTACT_API_KEY=

COMPANY_NAME=
COMPANY_REPRESENTATIVE=
COMPANY_ADDRESS=
COMPANY_CONTACT=
